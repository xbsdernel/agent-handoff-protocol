# Copy to docker/.env and adjust for the host.
#   cp docker/.env.example docker/.env
# docker/.env is git-ignored; it may contain a gated-model HF token.

# --- Shared model -----------------------------------------------------------
# All three engines must serve the same checkpoint. The vLLM and SGLang
# containers download it into HF_CACHE_DIR; llama-server needs a Q8_0 GGUF
# export of the same checkpoint in MODEL_DIR (see docker/README.md).
MODEL_ID=Qwen/Qwen2.5-7B-Instruct
SERVED_MODEL_NAME=qwen2.5-7b-instruct

# --- Hugging Face cache -----------------------------------------------------
# Absolute path on the host, mounted read/write at /root/.cache/huggingface.
# Defaults to $HOME/.cache/huggingface when using launch_engine.sh.
HF_CACHE_DIR=/home/your-user/.cache/huggingface
# Only needed for gated repositories (for example Meta-Llama-3.1-8B-Instruct).
HF_TOKEN=

# --- llama.cpp GGUF weights -------------------------------------------------
# MODEL_DIR is relative to the docker/ directory when used by Compose.
MODEL_DIR=./models
MODEL_FILE=qwen2.5-7b-instruct-q8_0.gguf

# --- Host ports (container port is always 8000) -----------------------------
VLLM_PORT=8001
SGLANG_PORT=8002
LLAMA_SERVER_PORT=8003

# --- Memory allocation ------------------------------------------------------
# vLLM: fraction of VRAM reserved for weights + KV cache.
VLLM_GPU_MEMORY_UTILIZATION=0.90
# SGLang: static fraction of VRAM reserved for weights + RadixAttention cache.
SGLANG_MEM_FRACTION_STATIC=0.85
# Shared context window for vLLM/SGLang/llama.cpp.
MAX_MODEL_LEN=8192
# llama.cpp total context window, split across the four parallel slots.
LLAMA_CTX_SIZE=8192
# 999 offloads every layer that fits on the GPU.
LLAMA_N_GPU_LAYERS=999

# --- launcher ---------------------------------------------------------------
# Seconds launch_engine.sh waits for /health and /v1/models before failing.
ENGINE_TIMEOUT=900
